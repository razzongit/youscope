# YouScope — environment configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.
#
# YouScope works with ANY OpenAI-compatible endpoint. Set BASE_URL + MODEL +
# API_KEY to whatever you have. Nothing is uploaded anywhere; the only network
# traffic is the requests you configure here, and only when you run AI modes.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for AI modes (Portrait → Digest / Full personal)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL up to but not including /chat/completions.
#   Z.AI (GLM)   https://api.z.ai/api/paas/v4    ← GLM Coding Plan
#   OpenRouter   https://openrouter.ai/api/v1
#   OpenAI       https://api.openai.com/v1
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   Groq         https://api.groq.com/openai/v1
#   Together     https://api.together.xyz/v1
#   DeepInfra    https://api.deepinfra.com/v1/openai
#   Fireworks    https://api.fireworks.ai/inference/v1
#   Mistral      https://api.mistral.ai/v1
#   Ollama       http://localhost:11434/v1        (no key needed)
#   LM Studio    http://localhost:1234/v1         (no key needed)
#   vLLM         http://localhost:8000/v1         (no key needed)
BASE_URL=https://api.z.ai/api/paas/v4

# Exact model id as the provider documents it. There is no sensible default —
# every provider names models differently.
#
#   Z.AI Coding Plan    glm-5.3-flash        (recommended, 3x quota)
#   Z.AI Coding Plan    glm-5.3-flashx       (faster, not on the plan)
#   Z.AI                glm-5.3
#   OpenRouter free     openrouter/free
#   OpenRouter free     google/gemma-4-26b-a4b-it:free
#   OpenAI              gpt-4o-mini
#   Gemini              gemini-2.0-flash
#   Groq                llama-3.3-70b-versatile
#   Ollama (local)      llama3.2
MODEL=glm-5.3-flash

# Your API key. Leave empty for local endpoints (Ollama / LM Studio / vLLM).
API_KEY=

# Skip auto-detection if your endpoint is a proxy. One of:
# zai · openrouter · openai · gemini · groq · ollama · custom
# Left blank, the app infers it from BASE_URL.
PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL tuning
# ─────────────────────────────────────────────────────────────────────────────

# Max tokens for one completion. Reasoning models burn tokens privately before
# answering — too low a value returns an empty response. If a model returns
# nothing, raise this first.
#
# glm-5.3-flash CANNOT disable thinking (thinking.type is always enabled), so it
# always spends reasoning tokens first. 8000 is the practical floor; 12000 gives
# the full analysis comfortable room. The app raises this automatically for
# recognised providers.
MAX_TOKENS=12000

# Sampling temperature.
# z.ai: valid range is exclusive (0,1) — 0 is REJECTED with HTTP 400. Recommended
#       value for glm-5.3-flash is 1.
# Most others: 0.4-0.7 works well for portrait writing.
# Leave blank to use the provider's recommended value.
TEMPERATURE=1

# Milliseconds to wait between the per-interest calls in Full personal mode.
# Free tiers rate-limit hard per minute; raise this if you see 429s.
REQUEST_DELAY_MS=1200

# Extra HTTP headers as JSON, if your endpoint needs them.
# EXTRA_HEADERS={"X-Custom":"value"}
EXTRA_HEADERS=

# Per-request timeout in milliseconds.
TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# CLI defaults
# ─────────────────────────────────────────────────────────────────────────────

# Where generated reports are written.
OUTPUT_DIR=./reports

# Print the JSON digest that would be sent to the model, then exit.
# Useful for seeing exactly what leaves your machine before you send it.
DRY_RUN=false
